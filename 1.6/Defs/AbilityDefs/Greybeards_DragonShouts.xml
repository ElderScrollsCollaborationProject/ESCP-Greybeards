    <AbilityDef>
        <defName>ESCP_Ability_FusRoDah</defName>
        <groupDef>ESCP_DragonShouts</groupDef>
        <label>Unrelenting Force</label>
        <description>Unrelenting Force the first and most iconic shout of the Greybeards. Three words of power released as a concentrated shockwave of the Voice that sends enemies flying. Even partial mastery of these three words can hurl an armed warrior across a courtyard. FUS RO DAH.</description>
        <iconPath>UI/Abilities/BulletShield</iconPath>
        <aiCanUse>true</aiCanUse>
        <hostile>true</hostile>
        <showOnCharacterCard>true</showOnCharacterCard>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <cooldownTicksRange>1800</cooldownTicksRange>
        <warmupStartSound>ESCP_Sound_FusRoDah</warmupStartSound>
        <verbProperties>
            <verbClass>ESCP.Core.Thuum.Verb_FusRoDah</verbClass>
            <requireLineOfSight>true</requireLineOfSight>
            <range>16</range>
            <warmupTime>1.5</warmupTime>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>true</canTargetAnimals>
                <canTargetMechs>true</canTargetMechs>
            </targetParams>
        </verbProperties>
        <modExtensions>
            <li Class="ESCP.Core.Thuum.FusRoDahExtension">
                <coneRange>16</coneRange>
                <coneHalfArc>55</coneHalfArc>
                <baseDamage>25</baseDamage>
                <knockbackCells>6</knockbackCells>
                <ticksPerStep>8</ticksPerStep>
            </li>
        </modExtensions>
    </AbilityDef>

