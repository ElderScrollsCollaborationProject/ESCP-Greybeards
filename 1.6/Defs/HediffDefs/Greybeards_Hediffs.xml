<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_WhirlwindSprint</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>Whirlwind Sprint</label>
        <description>The words of the sprint shout course through this pawn's body, driving their movements with supernatural speed.</description>
        <defaultLabelColor>(0.6, 0.85, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>180~180</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>20.0</MoveSpeed>
                </statOffsets>
                <statFactors>
                    <IncomingDamageFactor>0.6</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_MarkedForDeath</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>marked for death</label>
        <description>The words of power have unravelled this pawn's natural defenses, leaving them exposed and weakened.</description>
        <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <IncomingDamageFactor>1.6</IncomingDamageFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.15</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_IceForm</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>frozen solid</label>
        <description>This pawn has been encased in a shell of ice by the shout's power. They are almost entirely immobilized.</description>
        <defaultLabelColor>(0.4, 0.8, 1.0)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>480~480</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <postFactor>0.5</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_AuraWhisper</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>heightened aura</label>
        <description>The words of the whisper shout have attuned this pawn's senses to a razor edge. They perceive threats with uncanny clarity.</description>
        <defaultLabelColor>(0.9, 0.9, 0.5)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>900~900</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <postFactor>1.5</postFactor>
                    </li>
                </capMods>
                <statOffsets>
                    <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
                    <MeleeHitChance>0.08</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_Dragonrend</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>dragonrend</label>
        <description>The concept of mortality has been driven into this pawn's mind by the power of the Voice. Their consciousness reels and their will to fight wavers.</description>
        <defaultLabelColor>(0.5, 0.0, 0.7)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~600</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.6</postFactor>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>0.5</postFactor>
                    </li>
                </capMods>
                <statOffsets>
                    <ShootingAccuracyPawn>-0.20</ShootingAccuracyPawn>
                    <MeleeHitChance>-0.15</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_AnimalAllegiance</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>animal allegiance</label>
        <description>The words of kinship course through this pawn, sharpening their attunement to animals and lending mastery to their hands.</description>
        <defaultLabelColor>(0.5, 0.8, 0.4)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <WorkSpeedGlobal>1.5</WorkSpeedGlobal>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.3</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_BattleFury</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>battle fury</label>
        <description>The words of the fury shout drive this pawn's movements beyond mortal limits, every strike coming faster and harder than the last.</description>
        <defaultLabelColor>(0.9, 0.3, 0.1)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>900~900</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <AimingDelayFactor>0.25</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.4</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_BecomeEthereal</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>ethereal form</label>
        <description>This pawn's form has been rendered temporarily untouchable by the shout, all physical harm passing through while the words hold.</description>
        <defaultLabelColor>(0.7, 0.95, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>480~480</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <IncomingDamageFactor>0.0</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_BendWill</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>broken will</label>
        <description>The Voice has shattered this pawn's will entirely. They are barely able to move or act under the weight of the shout's command.</description>
        <defaultLabelColor>(0.6, 0.2, 0.8)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>0.2</postFactor>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.3</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_CallOfValor</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>valor of the ancients</label>
        <description>The spirit-strength of the ancient Nord heroes fills this pawn, sharpening every faculty and multiplying every action.</description>
        <defaultLabelColor>(1.0, 0.85, 0.3)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <WorkSpeedGlobal>1.8</WorkSpeedGlobal>
                    <AimingDelayFactor>0.4</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <ShootingAccuracyPawn>0.3</ShootingAccuracyPawn>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.4</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_Disarm</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>disarmed</label>
        <description>The shout has severed the bond between this pawn and their weapon. They can barely grip it and are nearly useless in a fight.</description>
        <defaultLabelColor>(0.8, 0.6, 0.2)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>480~480</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <AimingDelayFactor>8.0</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <ShootingAccuracyPawn>-0.8</ShootingAccuracyPawn>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.05</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_DragonAspect</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>dragon aspect</label>
        <description>The essence of dragonkind moves through this pawn. They are faster, harder to hurt, and more dangerous in every way while the shout's power holds.</description>
        <defaultLabelColor>(0.9, 0.6, 0.1)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>3600~3600</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <IncomingDamageFactor>0.4</IncomingDamageFactor>
                    <WorkSpeedGlobal>1.5</WorkSpeedGlobal>
                    <AimingDelayFactor>0.5</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>2.0</MoveSpeed>
                    <ShootingAccuracyPawn>0.2</ShootingAccuracyPawn>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.3</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_ElementalFury</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>elemental fury</label>
        <description>Wind, fire, and lightning flow through this pawn's weapon arm. Each strike arrives before the last has fully landed.</description>
        <defaultLabelColor>(0.9, 0.7, 0.1)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>900~900</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <AimingDelayFactor>0.1</AimingDelayFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_FrostBreath</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>frost-bitten</label>
        <description>The cold of the frost shout has seeped into this pawn's limbs. Their movements are sluggish and their extremities barely respond.</description>
        <defaultLabelColor>(0.5, 0.75, 1.0)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~600</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <AimingDelayFactor>4.0</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <ShootingAccuracyPawn>-0.4</ShootingAccuracyPawn>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>0.3</postFactor>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.5</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>ESCP_Hediff_Shout_SlowTime</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>slowed time</label>
        <description>The words of time bend the moment wider around this pawn. They move as though the world has slowed to a crawl on their behalf.</description>
        <defaultLabelColor>(0.7, 0.9, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>480~480</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <AimingDelayFactor>0.2</AimingDelayFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>5.0</MoveSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>
